package blog

import (
	"fmt"
	"github.com/NPEX42/webserver/app/blog"
	"github.com/NPEX42/webserver/components/common"
)


templ Post(post blog.Post) {
    <link href="/css/style.css" rel="stylesheet"/>
	<div class="blog post">
		<h1 class="banner">{post.Metadata.Title}</h1>
		<h3 class="author">Written By: {post.Metadata.Author}</h3>
		<hr/>
			@templ.Raw(post.RenderHTML())
	</div>


	<hr />
	@common.Footer("post")
}

templ PostPreview(post blog.Post) {
	<div class="blog preview">
			<a href={templ.URL(fmt.Sprintf("/blog/posts/%s", post.Metadata.ID))}>{post.Metadata.Title}</a>
	</div>
}
